# Claude: the agent's reasoning (steps 02 to 05). From your Anthropic Console account, or ask your Clarium
# Academy admin.
ANTHROPIC_API_KEY=

# LiveKit Cloud: speech-to-text, text-to-speech and rooms (steps 03 to 05). Create a free project at
# https://cloud.livekit.io and copy these from its API keys settings.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: any Claude model id.
HOTEL_AGENT_MODEL=claude-haiku-5-5

# Optional: "on" lets Claude think before each reply. Slower on a call; see the README.
HOTEL_AGENT_THINKING=off
