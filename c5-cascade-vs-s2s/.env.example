# Claude: the cascaded agent's model, and the judge that grades every reply. From your Anthropic Console account,
# or ask your Clarium Academy admin.
ANTHROPIC_API_KEY=

# LiveKit Cloud: speech-to-text and text-to-speech for the cascaded agent, and the voices that read the questions.
# The same free project as the hotel demo works: copy these from its API keys settings at https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini Live: the speech-to-speech agent. Create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: the models under test, and the judge.
BENCH_CASCADE_MODEL=claude-haiku-5-5
BENCH_S2S_MODEL=gemini-3.8-live
BENCH_JUDGE_MODEL=claude-sonnet-5-5
